CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
S3_ENDPOINT=http://127.0.0.1:8333
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=rag-admin
S3_SECRET_ACCESS_KEY=replace-me
S3_BUCKET=rag-documents
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=app
MYSQL_PASSWORD=replace-me
MYSQL_DATABASE=app
FILE_BASE_URL=http://ahanali.devcloud.woa.com:8888
REDIS_URL=redis://127.0.0.1:6379/0
FLOWER_BASIC_AUTH=rag:replace-me
FLOWER_ADDRESS=0.0.0.0
FLOWER_PORT=5555
MAX_DOCUMENT_BYTES=1048576000
UPLOAD_CHUNK_BYTES=8388608
UPLOAD_SESSION_TTL_HOURS=24
UPLOAD_COMPLETE_LEASE_SECONDS=300
ORPHAN_MPU_GRACE_HOURS=24
ORPHAN_OBJECT_RETENTION_DAYS=7
SESSION_RETENTION_DAYS=30
CLEANUP_BATCH_SIZE=50
MINERU_API_URL=
MINERU_API_KEY=

# 子块向量化：DashScope OpenAI 兼容接口，密钥只填写在本地 .env。
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024
INDEXING_BATCH_SIZE=10
INDEXING_TIMEOUT_SECONDS=60

# Milvus standalone：维度或模型改变时使用新集合并重建索引。
MILVUS_URI=http://127.0.0.1:19530
MILVUS_TOKEN=
MILVUS_DATABASE=default
MILVUS_COLLECTION=document_chunks

# Elasticsearch 8.x；默认需安装对应版本的 IK 插件。
# 无 IK 的开发实例可同时改用 standard；已有索引需换名后重建。
ES_URL=http://127.0.0.1:9200
ES_USERNAME=
ES_PASSWORD=
ES_API_KEY=
ES_CA_CERTS=
ES_INDEX=document_chunks
ES_ANALYZER=ik_max_word
ES_SEARCH_ANALYZER=ik_smart
